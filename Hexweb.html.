  }
  function syncPaneTabs(){$$('#paneTabs .tbtn').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.pane===wb.dataset.pane)));}
  function showData(which){
    hexTarget=which;dataChip.setAttribute('aria-pressed',String(which==='expected'));
    renderHex();setBottomTab('hex');
    if(which!=='fn')log('mem','inspecting '+DATA[which].label+' @ '+hex(DATA[which].addr,6),'info');
  }
  /* events */
  traceBtn.addEventListener('click',run);
  stepBtn.addEventListener('click',step);
  resetBtn.addEventListener('click',()=>reset(false));
  keyInput.addEventListener('input',()=>{if(running||S.halted||steps)reset(true);wb.classList.remove('cracked');});
  dataChip.addEventListener('click',()=>showData(hexTarget==='expected'?'fn':'expected'));
  hintBtn.addEventListener('click',()=>{const on=hintBar.classList.toggle('show');hintBtn.setAttribute('aria-pressed',String(on));});
  xrefChip.addEventListener('click',()=>{const x=FNS[curFn].xref;if(x){selectFn(x.fn);markSel(x.idx);}});
  fnList.addEventListener('click',e=>{const b=e.target.closest('[data-fn]');if(b)selectFn(b.dataset.fn);});
  $$('.fn-item[data-sym]').forEach(b=>b.addEventListener('click',()=>showData(b.dataset.sym)));
  disRows.addEventListener('click',e=>{const r=e.target.closest('[data-i]');if(r)markSel(+r.dataset.i);});
  hexRows.addEventListener('click',e=>{const h=e.target.closest('[data-i]');if(h){markSel(+h.dataset.i);}});
  disRows.addEventListener('pointerover',e=>{const r=e.target.closest('[data-i]');if(r&&hexTarget==='fn')hexRows.querySelectorAll('[data-i="'+r.dataset.i+'"]').forEach(x=>x.classList.add('sel'));});
  disRows.addEventListener('pointerout',e=>{const r=e.target.closest('[data-i]');if(r&&selIdx!==+r.dataset.i)hexRows.querySelectorAll('[data-i="'+r.dataset.i+'"]').forEach(x=>x.classList.remove('sel'));});
  ['#hexTab','#hexTab2'].forEach(s=>{const b=$(s);if(b)b.addEventListener('click',()=>setBottomTab('hex'));});
  ['#conTab','#conTab2'].forEach(s=>{const b=$(s);if(b)b.addEventListener('click',()=>setBottomTab('con'));});
