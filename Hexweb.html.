    if(matchMedia('(min-width:881px)').matches){
      hexPane.style.display=t==='hex'?'block':'none';
      conPane.style.display=t==='con'?'block':'none';
    }else{hexPane.style.display='';conPane.style.display='';wb.dataset.pane='hex';syncPaneTabs();}
    ['#hexTab','#hexTab2'].forEach(s=>{const b=$(s);if(b)b.setAttribute('aria-pressed',String(t==='hex'));});
