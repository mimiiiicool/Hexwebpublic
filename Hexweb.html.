    for(let i=0;i<16;i++){
      const s=document.createElement('span');s.className='spark-p';
      const a=Math.random()*6.28,d=90+Math.random()*220;
      s.style.setProperty('--tx',Math.cos(a)*d+'px');s.style.setProperty('--ty',Math.sin(a)*d+'px');
      s.style.setProperty('--hue',hues[i%4]);box.appendChild(s);
      setTimeout(()=>s.remove(),900);
    }
  }
  function ensureFn(){
    if(curFn!=='check_license'){selectFn('check_license');}
  }
  function reset(silent){
    running=false;clearTimeout(timer);timer=null;
    initState();clearMarks();renderRegs(false);
    traceBtn.textContent='▶ Trace';wb.classList.remove('cracked');
    setStatus('idle','idle — ready to trace');
    if(!silent)log('reset','machine state reinitialized · rip = 0x4011a0','dim');
  }
  function tick(){
    if(!running)return;
    const more=execOne(true);
    if(more&&running)timer=setTimeout(tick,300);
  }
  function run(){
    ensureFn();
    if(running){pause();return;}
    if(S.halted)reset(true);
    running=true;traceBtn.textContent='⏸ Pause';
    setStatus('run','tracing · step '+steps);
    log('trace','▶ tracing check_license("'+curKey()+'")','info');
    markActive(S.pc);renderRegs(false);
    timer=setTimeout(tick,180);
  }
  function pause(){
    running=false;clearTimeout(timer);timer=null;
    traceBtn.textContent='▶ Resume';
    setStatus('idle','paused · step '+steps+' — ⏭ to single-step');
  }
  function step(){
    ensureFn();
    if(running)pause();
    if(S.halted)reset(true);
    if(S.pc===0&&!steps)log('trace','⏭ single-stepping check_license("'+curKey()+'")','info');
    execOne(false);
    if(!S.halted){traceBtn.textContent='▶ Resume';setStatus('idle','paused · step '+steps+' · '+hex(FNS.check_license.insns[S.pc][0],6));}
  }
  function selectFn(k){
    if(!FNS[k])return;
    if(running)pause();
    curFn=k;selIdx=-1;
    renderFns();renderDis();renderDec();
    if(hexTarget==='fn')renderHex();
    clearMarks();
    if(k!=='check_license'){reset(true);setStatus('idle','viewing '+FNS[k].name+' — trace runs check_license');}
  }
  function setBottomTab(t){
    wb.dataset.btab=t;
    hexPane.style.display=t==='hex'?'':'';
