  let items=[],flat=[],sel=0,opener=null;
  const NAV_IC='<svg class="pi-ic" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>';
  const ACT_IC='<svg class="pi-ic" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>';
  const CMDS=[
    {g:'Navigate',label:'Live workbench',hint:'#workbench',run:()=>scrollToId('workbench')},
    {g:'Navigate',label:'Features',hint:'#features',run:()=>scrollToId('features')},
    {g:'Navigate',label:'Scripting tour',hint:'#scripting',run:()=>scrollToId('scripting')},
    {g:'Navigate',label:'Benchmarks',hint:'#benchmarks',run:()=>scrollToId('benchmarks')},
    {g:'Navigate',label:'Pricing',hint:'#pricing',run:()=>scrollToId('pricing')},
    {g:'Navigate',label:'Changelog',hint:'#changelog',run:()=>scrollToId('changelog')},
    {g:'Navigate',label:'FAQ',hint:'#faq',run:()=>scrollToId('faq')},
    {g:'Navigate',label:'Download',hint:'#download',run:()=>scrollToId('download')},
    {g:'Actions',label:'Run the license trace',hint:'workbench',run:()=>{scrollToId('workbench');setTimeout(()=>DEMO.run(),600);}},
    {g:'Actions',label:'Inspect g_expected bytes',hint:'.rodata',run:()=>{scrollToId('workbench');DEMO.showData();}},
    {g:'Actions',label:'Reveal license key (spoiler)',hint:'crackme',run:()=>{scrollToId('workbench');DEMO.reveal();}},
    {g:'Actions',label:'Copy install command',hint:OS,run:()=>copyText(CMDS[OS],'Install command copied')},
    {g:'Actions',label:'Download installer for this OS',hint:OS,run:()=>window.__dl(OS)},
    {g:'Actions',label:'Start Pro trial',hint:'14 days',run:()=>MODAL.open('Pro')},
    {g:'Actions',label:'Start Studio trial',hint:'team',run:()=>MODAL.open('Studio')}
  ];
  function score(label,q){
    if(!q)return{s:1,m:[]};
    const L=label.toLowerCase();let qi=0,m=[],s=0,last=-1;
    for(let i=0;i<L.length&&qi<q.length;i++){
      if(L[i]===q[qi]){m.push(i);s+=(i===0||L[i-1]===' ')?12:4;if(last>=0)s-=Math.min(i-last-1,6);last=i;qi++;}
    }
    return qi===q.length?{s,m}:-1;
  }
  function markLabel(label,m){
    let out='',mi=0;
    for(let i=0;i<label.length;i++){
      const c=label[i]==='<'?'&lt;':label[i];
      if(mi<m.length&&m[mi]===i){out+='<mark>'+c+'</mark>';mi++;}else out+=c;
    }
    return out;
  }
  function render(){
    const q=input.value.trim().toLowerCase();
    flat=[];let html='',lastG='';
    CMDS.forEach(c=>{
      const r=score(c.label,q);if(r===-1)return;
      flat.push({c,r});
    });
    flat.sort((a,b)=>b.r.s-a.r.s);
    const groups={};
    flat.forEach(f=>{(groups[f.c.g]=groups[f.c.g]||[]).push(f);});
    flat=[];
    ['Navigate','Actions'].forEach(g=>{
      if(!groups[g])return;
      html+='<div class="pal-group">'+g+'</div>';
      groups[g].forEach(f=>{
        const idx=flat.length;flat.push(f);
        html+='<button class="pal-item'+(idx===sel?' sel':'')+'" role="option" id="pal-o-'+idx+'" aria-selected="'+(idx===sel)+'" data-pi="'+idx+'">'+(g==='Navigate'?NAV_IC:ACT_IC)+'<span>'+markLabel(f.c.label,f.r.m)+'</span><span class="pi-k">'+f.c.hint+'</span></button>';
      });
    });
    if(!flat.length)html='<div class="pal-empty">no match — try “trace”, “price”, “install”…</div>';
    list.innerHTML=html;
    input.setAttribute('aria-activedescendant',flat.length?'pal-o-'+sel:'');
  }
  function open(){
    opener=document.activeElement;
    ov.classList.add('open');document.body.style.overflow='hidden';
    input.value='';sel=0;render();
    setTimeout(()=>input.focus(),40);
  }
  function close(){
    ov.classList.remove('open');document.body.style.overflow='';
    if(opener&&opener.focus)opener.focus();
  }
  function exec(i){
    const f=flat[i];if(!f)return;
    close();setTimeout(f.c.run,60);
  }
  function move(d){
    if(!flat.length)return;
    sel=(sel+d+flat.length)%flat.length;render();
    const el=list.querySelector('[data-pi="'+sel+'"]');
    if(el)el.scrollIntoView({block:'nearest'});
  }
  input.addEventListener('input',()=>{sel=0;render();});
  input.addEventListener('keydown',e=>{
    if(e.key==='ArrowDown'){e.preventDefault();move(1);}
    else if(e.key==='ArrowUp'){e.preventDefault();move(-1);}
    else if(e.key==='Enter'){e.preventDefault();exec(sel);}
    else if(e.key==='Escape'){close();}
  });
  list.addEventListener('click',e=>{const b=e.target.closest('[data-pi]');if(b)exec(+b.dataset.pi);});
  list.addEventListener('pointermove',e=>{const b=e.target.closest('[data-pi]');if(b&&+b.dataset.pi!==sel){sel=+b.dataset.pi;render();}});
  ov.addEventListener('click',e=>{if(e.target===ov)close();});
  return{open,close,toggle:()=>ov.classList.contains('open')?close():open(),isOpen:()=>ov.classList.contains('open')};
})();
$('#cmdkBtn').addEventListener('click',PALETTE.open);
$$('.cmdk-open').forEach(b=>b.addEventListener('click',PALETTE.open));

/* ---------- global keys ---------- */
addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&(e.key==='k'||e.key==='K')){e.preventDefault();PALETTE.toggle();return;}
  if(e.key==='Escape'){
    if(PALETTE.isOpen())PALETTE.close();
    else if(MODAL.isOpen())MODAL.close();
    else closeMenu();
  }
});
})();
</script>
</body>
